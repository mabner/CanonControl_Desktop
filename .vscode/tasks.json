{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "kill-gvfs",
            "type": "shell",
            "command": "killall gvfsd-gphoto2 || true && killall gvfsd || true",
            "windows": {
                "command": "echo Skipping gvfs kill on Windows"
            }
        },
        {
            "label": "enable-display",
            "type": "shell",
            "command": "xhost +SI:localuser:$(whoami) || true",
            "windows": {
                "command": "echo Skipping xhost on Windows"
            }
        },
        {
            "label": "prepare-run",
            "dependsOn": [
                "build",
                "kill-gvfs",
                "enable-display"
            ],
            "dependsOrder": "sequence"
        }
    ]
}