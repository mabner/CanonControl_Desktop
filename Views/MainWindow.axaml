<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CanonControl.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:views="using:CanonControl.Views"
        xmlns:helpers="using:CanonControl.Helpers"
        x:Class="CanonControl.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="800" Height="{Binding WindowHeight}"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="3*,2*">
                <!-- Navigation Bar (Row 0, ColumnSpan 2) -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <!-- Navigation buttons with smaller font and text wrapping -->
                        <Button Grid.Column="0"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding NavigateToRemoteCaptureCommand}"
                                IsEnabled="{Binding IsCameraConnected}"
                                Classes.accent="{Binding CurrentContext, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RemoteCapture}">
                                <TextBlock Text="Remote&#x0a;Capture"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                        </Button>
                        <Button Grid.Column="1"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding NavigateToFocusStackCommand}"
                                IsEnabled="{Binding IsCameraConnected}"
                                Classes.accent="{Binding CurrentContext, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FocusStack}">
                                <TextBlock Text="Focus&#x0a;Stack"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                        </Button>
                        <Button Grid.Column="2"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding NavigateToExposureBracketingCommand}"
                                IsEnabled="{Binding IsCameraConnected}"
                                Classes.accent="{Binding CurrentContext, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ExposureBracketing}">
                                <TextBlock Text="Exposure&#x0a;Bracketing"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                        </Button>
                        <Button Grid.Column="3"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding NavigateToTimeLapseCommand}"
                                IsEnabled="{Binding IsCameraConnected}"
                                Classes.accent="{Binding CurrentContext, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TimeLapse}">
                                <TextBlock Text="Time&#x0a;Lapse"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                        </Button>
                        <Button Grid.Column="4"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding NavigateToSettingsCommand}"
                                Classes.accent="{Binding CurrentContext, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Settings}">
                                <TextBlock Text="Settings"
                                           TextAlignment="Center"
                                           FontSize="14" />
                        </Button>

                        <!-- Battery Status -->
                        <TextBlock Grid.Column="5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Width="70"
                                   Margin="4"
                                   FontSize="14"
                                   Text="{Binding BatteryStatus}" />


                        <!-- Single connection toggle button -->
                        <Button Grid.Column="6" Grid.ColumnSpan="2"
                                MinWidth="90" MinHeight="50" Margin="4"
                                Command="{Binding ToggleConnectionCommand}"
                                IsEnabled="True">
                                <TextBlock Text="{Binding ConnectionButtonLabel}"
                                           TextAlignment="Center"
                                           FontSize="14"
                                           Foreground="{Binding ConnectionButtonTextColour}" />
                        </Button>
                </Grid>

                <!-- Live View Area (Row 1, Column 0) -->
                <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform">
                        <Grid Width="{Binding LiveViewSurfaceWidth}" Height="{Binding LiveViewSurfaceHeight}" Background="Black" PointerPressed="OnLiveViewPointerPressed">
                                <Image Source="{Binding LiveImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="LowQuality" />

                                <!-- Composition Aid Overlay -->
                                <views:CompositionAidControl CompositionMode="{Binding CompositionAidMode}"
                                                             IsMirrored="{Binding IsCompositionMirrored}"
                                                             Rotation="{Binding CompositionRotation}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch"
                                                             IsVisible="{Binding CompositionAidMode, Converter={StaticResource EnumNotEqualConverter}, ConverterParameter=None}" />

                                <!-- Histogram Overlay -->
                                <views:HistogramControl Histogram="{Binding HistogramData}"
                                                        DisplayMode="{Binding HistogramDisplayMode}"
                                                        Width="200" Height="100"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        IsVisible="{Binding HistogramDisplayMode, Converter={StaticResource EnumNotEqualConverter}, ConverterParameter=None}" />

                                <!-- Focus point overlay -->
                                <Canvas x:Name="FocusOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Rectangle x:Name="FocusRect" Width="80" Height="80" Fill="Transparent" Stroke="White" StrokeThickness="2"
                                                   IsVisible="{Binding IsFocusSquareVisible}" />
                                </Canvas>
                        </Grid>
                </Viewbox>

                <!-- Control Panel (Row 2, Column 0) -->
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" Margin="4" Spacing="4">
                        <StackPanel Orientation="Vertical" Margin="4" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button MinWidth="50" MinHeight="50" Margin="4"
                                                Command="{Binding ToggleLiveViewCommand}"
                                                IsEnabled="{Binding IsCameraConnected}">
                                                <TextBlock Text="Live&#x0a;View"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="14" />
                                        </Button>
                                        <!-- Directional focus point controls (small) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="▲"
                                                        Command="{Binding MoveFocusUpCommand}"
                                                        MinWidth="50" MinHeight="50"
                                                        Margin="2"
                                                        IsEnabled="{Binding IsLiveViewActive}" />
                                                <Button Content="◄"
                                                        Command="{Binding MoveFocusLeftCommand}"
                                                        MinWidth="50" MinHeight="50"
                                                        Margin="2"
                                                        IsEnabled="{Binding IsLiveViewActive}" />
                                                <Button Content="►"
                                                        Command="{Binding MoveFocusRightCommand}"
                                                        MinWidth="50" MinHeight="50"
                                                        Margin="2"
                                                        IsEnabled="{Binding IsLiveViewActive}" />
                                                <Button Content="▼"
                                                        Command="{Binding MoveFocusDownCommand}"
                                                        MinWidth="50" MinHeight="50"
                                                        Margin="2"
                                                        IsEnabled="{Binding IsLiveViewActive}" />
                                        </StackPanel>
                                        <Button MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding ContextCaptureCommand}"
                                                IsEnabled="{Binding IsCameraConnected}">
                                                <TextBlock Text="{Binding ContextCaptureLabel}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="14" />
                                        </Button>
                                        <Button x:Name="AutoFocusButton"
                                                MinWidth="50" MinHeight="50" Margin="2"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="Auto&#x0a;Focus"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="14" />
                                        </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="FocusNearCoarseButton" MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding FocusNearCoarseCommand}"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&lt;&lt;&lt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="16" />
                                        </Button>
                                        <Button x:Name="FocusNearMediumButton" MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding FocusNearMediumCommand}"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&lt;&lt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="16" />
                                        </Button>
                                        <Button x:Name="FocusNearButton"
                                                MinWidth="50" MinHeight="50" Margin="2"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&lt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="20" />
                                        </Button>
                                        <Button x:Name="FocusFarButton"
                                                MinWidth="50" MinHeight="50" Margin="2"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&gt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="20" />
                                        </Button>
                                        <Button x:Name="FocusFarMediumButton" MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding FocusFarMediumCommand}"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&gt;&gt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="16" />
                                        </Button>
                                        <Button x:Name="FocusFarCoarseButton" MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding FocusFarCoarseCommand}"
                                                IsEnabled="{Binding IsLiveViewActive}">
                                                <TextBlock Text="&gt;&gt;&gt;"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="16" />
                                        </Button>
                                        <Button x:Name="ShowAFButton" MinWidth="50" MinHeight="50" Margin="2"
                                                Command="{Binding ToggleFocusSquareCommand}">
                                                <TextBlock Text="{Binding FocusSquareButtonLabel}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="14" />
                                        </Button>
                                </StackPanel>
                        </StackPanel>
                </StackPanel>

                <!-- Side Panel (Row 1, Column 1) -->
                <!-- ContentControl uses ViewLocator (from App.axaml.DataTemplates) to automatically resolve views for ViewModels -->
                <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding CurrentSidePanelViewModel}" />
                </ScrollViewer>
        </Grid>
</Window>
